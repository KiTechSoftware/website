---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | KiTech Software"
  description="The requested page could not be found on the KiTech Software website."
  canonicalPath="/404/"
>
  <main id="main-content" class="not-found" tabindex="-1">
    <div class="container not-found-card">
      <p class="eyebrow">404</p>
      <h1>Page not found.</h1>
      <p>The page may have moved, or the address may be incorrect.</p>
      <a class="button" href="/">Return home</a>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found {
    min-height: 68vh;
    display: grid;
    place-items: center;
    padding: 88px 0;
    background: linear-gradient(180deg, var(--surface-grad-a), var(--surface));
  }

  .not-found-card {
    max-width: 820px;
    padding: 64px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card-bg);
    box-shadow: var(--shadow);
  }

  .not-found-card h1 {
    max-width: none;
    font-size: clamp(3rem, 8vw, 5.5rem);
  }

  .not-found-card > p:not(.eyebrow) {
    margin-bottom: 28px;
    color: var(--muted);
    font-size: 1.1rem;
  }

  @media (max-width: 640px) {
    .not-found-card {
      padding: 36px 26px;
    }
  }
</style>
