---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Products | KiTech Software"
  description="Product information, support, privacy, and account-management entry points for KiTech Software applications."
  canonicalPath="/products/"
>
  <main id="main-content" class="info-page" tabindex="-1">
    <div class="container narrow">
      <p class="eyebrow">Products</p>
      <h1>Product information and policies</h1>
      <p class="lead">
        Direct support, privacy, and account-management information for KiTech Software products prepared for public distribution.
      </p>

      <section class="product-grid" aria-label="KiTech Software products">
        <article class="product-card">
          <p class="product-type">Communication and collaboration</p>
          <h2>SecDoma</h2>
          <p>
            Secure communication and collaboration for personal accounts, organisations, managed cloud environments, and self-hosted deployments.
          </p>
          <div class="link-grid">
            <a href="/products/secdoma/">Overview</a>
            <a href="/products/secdoma/support/">Support</a>
            <a href="/products/secdoma/privacy/">Privacy</a>
            <a href="/products/secdoma/delete-account/">Delete account</a>
          </div>
        </article>

        <article class="product-card">
          <p class="product-type">Email infrastructure</p>
          <h2>Bantay Mail</h2>
          <p>
            Self-hosted email infrastructure for organisations that control their own mail, identity, authentication, and administration.
          </p>
          <div class="link-grid">
            <a href="/products/bantay-mail/">Overview</a>
            <a href="/products/bantay-mail/support/">Support</a>
            <a href="/products/bantay-mail/privacy/">Privacy</a>
            <a href="/products/bantay-mail/delete-account/">Delete account</a>
          </div>
        </article>
      </section>

      <section class="panel">
        <h2>Company-wide information</h2>
        <div class="link-grid company-links">
          <a href="/support/">Support</a>
          <a href="/legal/privacy/">Privacy Policy</a>
          <a href="/legal/terms/">Terms of Service</a>
          <a href="/support/delete-account/">Account deletion</a>
          <a href="/privacy/choices/">Privacy choices</a>
          <a href="/security/">Security</a>
        </div>
      </section>

      <section class="panel">
        <h2>Need help identifying a product?</h2>
        <p>
          Email <a href="mailto:hello@kitechsoftware.com?subject=Product%20support">hello@kitechsoftware.com</a> with the application name, platform, and developer name displayed in the store listing.
        </p>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .info-page { min-height: 70vh; padding: 88px 0 112px; background: linear-gradient(180deg, var(--surface-grad-a), var(--surface)); }
  .narrow { max-width: 980px; }
  h1 { max-width: 800px; font-size: clamp(3rem, 7vw, 5rem); }
  .lead { max-width: 760px; color: var(--muted); font-size: 1.18rem; }
  .product-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; margin-top: 36px; }
  .product-card, .panel { padding: 30px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--card-bg); }
  .product-card { display: flex; flex-direction: column; }
  .product-card h2, .panel h2 { margin-bottom: 12px; }
  .product-card > p:not(.product-type), .panel p { color: var(--muted); }
  .product-type { margin-bottom: 10px; color: var(--accent); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .panel { margin-top: 24px; }
  .link-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-top: auto; padding-top: 20px; }
  .link-grid a { padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px; color: var(--accent-secondary); font-weight: 700; text-decoration: none; }
  .link-grid a:hover, .link-grid a:focus-visible { border-color: var(--accent-secondary); }
  .company-links { grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 0; padding-top: 0; }
  @media (max-width: 760px) {
    .info-page { padding: 68px 0 88px; }
    .product-grid, .company-links { grid-template-columns: 1fr; }
  }
</style>
